# Frontend Environment Variables
# Copy this file to .env.local and update with your values

# API Configuration
# API origin only. The frontend adds /api to this value.
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Server-side AI chat configuration (set a real key in local .env; never commit it)
GROQ_API_KEY=your-groq-api-key

# Supabase (Project Connect dialog). These values are safe to expose to the browser;
# access is controlled with Auth and Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://twozsmktgeiyhvikhrgw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Analytics and Monitoring
NEXT_PUBLIC_GA_ID=your-google-analytics-id
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# eCourts API (if needed on frontend)
NEXT_PUBLIC_ECOURTS_API_URL=https://api.ecourts.gov.in

# Map Services (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Gateway (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key

# WebSocket URL (if using real-time features)
NEXT_PUBLIC_WS_URL=wss://yourdomain.com/ws

# CDN Configuration (if using CDN)
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Environment
NODE_ENV=production

# Build Configuration
NEXT_TELEMETRY_DISABLED=1
