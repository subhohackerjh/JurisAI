# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production-32-chars-minimum
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# Database — Supabase PostgreSQL (production)
# Get password: Supabase Dashboard → Project Settings → Database → Database password
DATABASE_URL=postgres://postgres:[YOUR-SUPABASE-DB-PASSWORD]@db.jumjwjvmjitwxcosxeqt.supabase.co:5432/postgres
# Leave DATABASE_URL unset to use SQLite for local dev

# Supabase API credentials
SUPABASE_URL=https://jumjwjvmjitwxcosxeqt.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Redis Configuration
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=your-redis-password

# JWT Authentication Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Strict

# eCourts API Configuration
ECOURTS_API_KEY=your-ecourts-api-key-here
ECOURTS_BASE_URL=https://api.ecourts.gov.in

# Media and Static Files
MEDIA_ROOT=/var/www/legal24/media
STATIC_ROOT=/var/www/legal24/static
MEDIA_URL=/media/
STATIC_URL=/static/

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

# Cache Configuration
CACHE_TTL=3600  # 1 hour default
CACHE_MIDDLEWARE_SECONDS=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/legal24/django.log
ERROR_LOG_FILE=/var/log/legal24/django-error.log

# Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=redis

# Monitoring and Analytics
ENABLE_ANALYTICS=True
SENTRY_DSN=your-sentry-dsn-here
PAPERTRAIL_API_TOKEN=your-papertrail-token

# Performance Settings
CONN_MAX_AGE=60
TEMPLATES_AUTO_RELOAD=False

# Development Override
if DEBUG:
    ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app
    CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
